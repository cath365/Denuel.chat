rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomPayload() {
      return request.resource.data.keys().hasOnly([
        'kind',
        'name',
        'createdAt',
        'updatedAt',
        'createdBy',
        'createdByName',
        'lastMessageText',
        'memberIds',
        'memberNames'
      ]);
    }

    function roomIsReadable(roomData) {
      return roomData.kind == 'channel' ||
        roomData.memberIds.hasAny([request.auth.uid]);
    }

    function isMessagePayload() {
      return request.resource.data.keys().hasOnly([
        'text',
        'senderId',
        'senderName',
        'createdAt',
        'attachmentName',
        'attachmentSize',
        'attachmentType',
        'attachmentUrl'
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && roomIsReadable(resource.data);
      allow create: if isSignedIn() && isRoomPayload();
      allow update: if isSignedIn() && roomIsReadable(resource.data);

      match /messages/{messageId} {
        allow read: if isSignedIn() && roomIsReadable(get(/databases/$(database)/documents/rooms/$(roomId)).data);
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isMessagePayload() &&
          roomIsReadable(get(/databases/$(database)/documents/rooms/$(roomId)).data);
      }
    }
  }
}
