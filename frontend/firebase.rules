rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isRoomPayload() {
      return request.resource.data.keys().hasOnly([
        'kind',
        'name',
        'topic',
        'createdAt',
        'updatedAt',
        'createdBy',
        'createdByName',
        'lastMessageText',
        'lastMessageSenderId',
        'memberIds',
        'memberNames',
        'unreadCounts'
      ]);
    }

    function roomIsReadable(roomData) {
      return roomData.kind == 'channel' ||
        roomData.memberIds.hasAny([request.auth.uid]);
    }

    function isMessagePayload() {
      return request.resource.data.keys().hasOnly([
        'text',
        'senderId',
        'senderName',
        'createdAt',
        'attachmentName',
        'attachmentSize',
        'attachmentType',
        'attachmentUrl',
        'deletedAt',
        'editedAt',
        'isDeleted',
        'isPinned',
        'pinnedAt',
        'pinnedById',
        'pinnedByName',
        'reactions'
      ]);
    }

    function isReadStatePayload() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'lastReadAt',
        'lastReadMessageId'
      ]);
    }

    function isTypingPayload() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'isTyping',
        'updatedAt'
      ]);
    }

    function messageRoomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isReactionOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'reactions'
      ]);
    }

    function isPinOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isPinned',
          'pinnedAt',
          'pinnedById',
          'pinnedByName'
        ]) &&
        (
          request.resource.data.isPinned == false ||
          request.resource.data.pinnedById == request.auth.uid
        );
    }

    function isOwnMessageUpdate() {
      return request.auth.uid == resource.data.senderId &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.senderName == resource.data.senderName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text',
          'attachmentName',
          'attachmentSize',
          'attachmentType',
          'attachmentUrl',
          'editedAt',
          'isDeleted',
          'deletedAt',
          'reactions'
        ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && roomIsReadable(resource.data);
      allow create: if isSignedIn() && isRoomPayload();
      allow update: if isSignedIn() && roomIsReadable(resource.data);

      match /messages/{messageId} {
        allow read: if isSignedIn() && roomIsReadable(messageRoomData(roomId));
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isMessagePayload() &&
          roomIsReadable(messageRoomData(roomId));
        allow update: if isSignedIn() &&
          roomIsReadable(messageRoomData(roomId)) &&
          (
            isReactionOnlyUpdate() ||
            isPinOnlyUpdate() ||
            isOwnMessageUpdate()
          );
      }

      match /readStates/{userId} {
        allow read: if isSignedIn() &&
          roomIsReadable(messageRoomData(roomId));
        allow create, update: if isSignedIn() &&
          request.auth.uid == userId &&
          isReadStatePayload() &&
          roomIsReadable(messageRoomData(roomId));
      }

      match /typing/{userId} {
        allow read: if isSignedIn() &&
          roomIsReadable(messageRoomData(roomId));
        allow create, update: if isSignedIn() &&
          request.auth.uid == userId &&
          isTypingPayload() &&
          roomIsReadable(messageRoomData(roomId));
      }
    }
  }
}
